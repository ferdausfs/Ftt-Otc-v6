index 0000000..a8ff7e2
--- /dev/null
+++ b/src/handlers/pushToSubscribers.js
@@ -0,0 +1,349 @@
+/**
+ * Phase 10 — cross-surface signal push.
+ *
+ * When a fresh BUY/SELL signal is generated by ANY caller (App view, Bot
+ * command, Bot autoScan), matching Telegram subscribers are notified straight
+ * from the worker — no cache, no polling, sub-second delivery.
+ *
+ * ── Design decisions, all driven by live inspection of the Bot repo ─────────
+ *
+ * 1. Subscriber enumeration uses the Bot's OWN index (`auto_users`), not a
+ *    `BOT_KV.list({prefix:'u:'})` scan. The Bot maintains that array itself
+ *    (getAutoUsers/addAutoUser) and its cron reads exactly it, so we see the
+ *    same population the Bot does — and pay 1 + N reads instead of a full
+ *    keyspace list on every signal.
+ *
+ * 2. Filter semantics are copied from the Bot's own passGrade/passConf/passAI
+ *    helpers, NOT from the rank-table in the Phase 10 spec. The Bot only ever
+ *    stores gradeFilter values 'ALL' | 'AB' | 'A' (settings keyboard line 606);
+ *    a numeric A+/A/B/C/D ranking would mis-filter every subscriber.
+ *
+ * 3. Messages are sent as PLAIN TEXT with no parse_mode. The Bot deliberately
+ *    removed parse_mode after its Bug#1: signal text contains ( ) . ! - _ which
+ *    made Telegram reject MarkdownV2 with HTTP 400 while the error was only
+ *    logged, so users silently got nothing. The spec's `parse_mode:'HTML'`
+ *    would reintroduce that class of failure (entryReason regularly contains
+ *    '<' / '&' style characters). See PHASE_10_REPORT.md §1.3.
+ *
+ * 4. A per-signal push-lock makes the push idempotent. /api/signal is called
+ *    constantly (App auto-refresh is 60s post-revert, Bot cron every 5min, plus
+ *    every manual view), and each call mints a NEW signalId even when the
+ *    worker's own 30-minute dedup guard treats it as a re-poll. Without a lock
+ *    one setup would be pushed dozens of times. See §1.4.
+ */
+
+
+
+const PUSH_LOG_PREFIX  = 'pushLog:';    // pushLog:<signalId> -> [{chatId, sentAt}]
+const PUSH_LOCK_PREFIX = 'pushLock:';   // pushLock:<chatId>:<PAIR>:<DIR> -> signalId
+const PUSH_LOG_TTL_S   = 24 * 3600;
+/**
+ * How long one (subscriber, pair, direction) stays muted after a push.
+ * Mirrors the worker's own DEDUP_WINDOW_MS (30 min) so a push happens exactly
+ * when a genuinely new setup is recorded in history, not on every re-poll.
+ */
+const PUSH_LOCK_TTL_S  = 30 * 60;
+
+const TELEGRAM_API = 'https://api.telegram.org';
+
+/** Bot stores pairs slash-less ("EURUSD"); normalise both sides before compare. */
+function normPair(p) {
+  return String(p || '').toUpperCase().replace(/[^A-Z0-9]/g, '');
+}
+
+function confPct(sig) {
+  return parseInt(String((sig && sig.confidence) || '0%').replace('%', ''), 10) || 0;
+}
+
+// ── filter helpers — mirrored from the Bot's own implementation ─────────
+export function passGrade(sig, f) {
+  if (!f || f === 'ALL') return true;
+  const g = (sig && sig.grade && sig.grade.grade) || '';
+  if (!g) return false;
+  return f === 'A' ? g === 'A' : f === 'AB' ? ['A', 'B'].includes(g) : true;
+}
+
+export function passConf(sig, min) {
+  if (!min) return true;
+  return confPct(sig) >= min;
+}
+
+export function passAI(sig, aiOnly) {
+  if (!aiOnly) return true;
+  return !!(sig && sig.aiValidation
+    && sig.aiValidation.status === 'OK' && sig.aiValidation.agrees === true);
+}
+
+/**
+ * Everyone who should receive this signal.
+ * Returns [{ chatId, channelId }] — channelId mirrors the Bot's [F10] behaviour.
+ */
+export async function getMatchingSubscribers(signal, env) {
+  if (!env || !env.BOT_KV) return [];
+  const sig = signal && signal.signal;
+  if (!sig) return [];
+
+  let autoUsers;
+  try {
+    autoUsers = await env.BOT_KV.get('auto_users', 'json');
+  } catch (e) {
+    console.warn('push: auto_users read failed: ' + e.message);
+    return [];
+  }
+  if (!Array.isArray(autoUsers) || autoUsers.length === 0) return [];
+
+  const want = normPair(signal.pair);
+  const matches = [];
+
+  for (const cid of autoUsers) {
+    try {
+      const user = await env.BOT_KV.get('u:' + cid, 'json');
+      if (!user || user.autoEnabled !== true) continue;
+
+      const watched = [user.pair, ...(Array.isArray(user.watchlist) ? user.watchlist : [])]
+        .filter(Boolean)
+        .map(normPair);
+      if (!watched.includes(want)) continue;
+
+      // Same three gates the Bot applies in autoScan.
+      if (!passConf(sig, user.minConfidence)) continue;
+      if (!passGrade(sig, user.gradeFilter)) continue;
+      if (!passAI(sig, user.aiOnlyMode)) continue;
+
+      matches.push({ chatId: String(cid), channelId: user.channelId || null });
+    } catch (e) {
+      console.warn('push: user read failed for ' + cid + ': ' + e.message);
+    }
+  }
+  return matches;
+}
+
+/**
+ * Claim the right to push this (subscriber, pair, direction) combination.
+ * Returns true only for the first caller inside the lock window.
+ *
+ * KV has no atomic compare-and-set, so a genuine race can let two concurrent
+ * requests both claim. That is acceptable: the worst case is one duplicate
+ * message, versus dozens without the lock.
+ */
+async function claimPushLock(chatId, signal, env) {
+  if (!env.SIGNAL_CACHE) return true;
+  const key = PUSH_LOCK_PREFIX + chatId + ':' + normPair(signal.pair)
+    + ':' + signal.signal.finalSignal;
+  try {
+    const held = await env.SIGNAL_CACHE.get(key);
+    if (held) return false;
+    await env.SIGNAL_CACHE.put(key, signal.id, { expirationTtl: PUSH_LOCK_TTL_S });
+    return true;
+  } catch (e) {
+    // Never let lock bookkeeping suppress a signal.
+    console.warn('push: lock check failed: ' + e.message);
+    return true;
+  }
+}
+
+/**
+ * Push a fresh signal to every matching subscriber.
+ * Call inside ctx.waitUntil() — never block the caller's response.
+ */
+export async function pushSignalToSubscribers(signal, env) {
+  if (!signal || !signal.id) return { pushed: 0, skipped: 'no-id' };
+  const sig = signal.signal;
+  if (!sig || !['BUY', 'SELL'].includes(sig.finalSignal)) {
+    return { pushed: 0, skipped: 'not-actionable' };
+  }
+  if (!env || !env.BOT_TOKEN) {
+    // Not an error: push is opt-in via secret. Stay silent to avoid log spam
+    // on every single signal when the feature simply is not configured.
+    return { pushed: 0, skipped: 'no-token' };
+  }
+
+  try {
+    const subscribers = await getMatchingSubscribers(signal, env);
+    if (subscribers.length === 0) return { pushed: 0, skipped: 'no-match' };
+
+    // Idempotency: only push to subscribers not already notified about this
+    // pair+direction inside the lock window.
+    const eligible = [];
+    for (const sub of subscribers) {
+      if (await claimPushLock(sub.chatId, signal, env)) eligible.push(sub);
+    }
+    if (eligible.length === 0) return { pushed: 0, skipped: 'locked' };
+
+    const message = formatSignalMessage(signal);
+    const results = await Promise.allSettled(
+      eligible.map(sub => sendTelegramMessage(sub.chatId, message, env)),
+    );
+
+    const delivered = [];
+    results.forEach((r, i) => {
+      if (r.status === 'fulfilled') delivered.push(eligible[i]);
+    });
+
+    // Channel mirroring ([F10] parity) — best effort, never gates the DM.
+    await Promise.allSettled(
+      delivered.filter(s => s.channelId)
+        .map(s => sendTelegramMessage(s.channelId, message, env)),
+    );
+
+    if (delivered.length > 0 && env.SIGNAL_CACHE) {
+      const now = new Date().toISOString();
+      await env.SIGNAL_CACHE.put(
+        PUSH_LOG_PREFIX + signal.id,
+        JSON.stringify(delivered.map(s => ({ chatId: s.chatId, sentAt: now }))),
+        { expirationTtl: PUSH_LOG_TTL_S },
+      );
+    }
+
+    console.log('Phase 10 push: ' + signal.id + ' ' + signal.pair + ' '
+      + sig.finalSignal + ' -> ' + delivered.length + '/' + eligible.length
+      + ' delivered (' + subscribers.length + ' matched)');
+    return { pushed: delivered.length, matched: subscribers.length };
+  } catch (e) {
+    console.warn('pushSignalToSubscribers error: ' + e.message);
+    return { pushed: 0, error: e.message };
+  }
+}
+
+/**
+ * Result push — fired by the cron result checker when a signal resolves.
+ * Only the subscribers who actually received the original signal are told.
+ */
+export async function pushResultToSubscribers(record, winLoss, exitPrice, env) {
+  if (!record || !record.id) return { pushed: 0 };
+  if (!['WIN', 'LOSS'].includes(winLoss)) return { pushed: 0, skipped: 'undecided' };
+  if (!env || !env.BOT_TOKEN || !env.SIGNAL_CACHE) return { pushed: 0, skipped: 'not-configured' };
+
+  try {
+    const logKey = PUSH_LOG_PREFIX + record.id;
+    const log = await env.SIGNAL_CACHE.get(logKey, 'json');
+    if (!Array.isArray(log) || log.length === 0) return { pushed: 0, skipped: 'never-pushed' };
+
+    const message = formatResultMessage(record, winLoss, exitPrice);
+    const results = await Promise.allSettled(
+      log.map(entry => sendTelegramMessage(entry.chatId, message, env)),
+    );
+    const delivered = results.filter(r => r.status === 'fulfilled').length;
+
+    // One result per signal — drop the log so a re-resolve cannot double-notify.
+    await env.SIGNAL_CACHE.delete(logKey).catch(() => {});
+
+    console.log('Phase 10 result push: ' + record.id + ' ' + winLoss
+      + ' -> ' + delivered + '/' + log.length);
+    return { pushed: delivered };
+  } catch (e) {
+    console.warn('pushResultToSubscribers error: ' + e.message);
+    return { pushed: 0, error: e.message };
+  }
+}
+
+// ── message formatting ─────────────────────────────────────────────────
+export function formatSignalMessage(signal) {
+  const sig = signal.signal;
+  const dir = sig.finalSignal;
+  const emoji = dir === 'BUY' ? '🟢' : '🔴';
+  const idShort = String(signal.id || '').slice(-4);
+  const bestTF = (sig.bestTimeframe && sig.bestTimeframe.timeframe) || '5min';
+  const rec = (sig.recommendations && sig.recommendations[bestTF]) || {};
+  const entry = rec.entry && rec.entry.price;
+  const expMin = rec.expiry && rec.expiry.totalMinutes;
+  const countdown = rec.expiry && rec.expiry.countdown && rec.expiry.countdown.label;
+  const grade = (sig.grade && sig.grade.grade) || '';
+  const label = (sig.grade && sig.grade.label) || '';
+
+  const lines = [];
+  lines.push('📌 Signal No. ' + idShort);
+  lines.push('📊 ' + signal.pair + ' | ' + bestTF);
+  lines.push('━━━━━━━━━━━━━━');
+  lines.push(emoji + ' ' + dir + '  ' + (sig.confidence || '') + '  ' + (grade + ' ' + label).trim());
+  if (entry != null) lines.push('💰 Entry: ' + entry);
+  if (expMin != null) lines.push('⏰ Expiry: ' + expMin + ' min');
+  if (countdown) lines.push('🕐 Candle closes: ' + countdown);
+  if (sig.higherTFTrend) lines.push('📈 HTF: ' + sig.higherTFTrend);
+  if (sig.marketRegime) lines.push('🟡 Regime: ' + sig.marketRegime);
+  if (sig.regimeAdvice) lines.push('💡 ' + sig.regimeAdvice);
+  if (sig.entryReason) { lines.push(''); lines.push('📝 ' + sig.entryReason); }
+  lines.push('');
+  lines.push('⏳ Result will be tracked automatically');
+  lines.push('⚡ Live push · fresh generation');
+  return lines.join('\n');
+}
+
+export function formatResultMessage(record, winLoss, exitPrice) {
+  const emoji = winLoss === 'WIN' ? '🏆' : '❌';
+  const idShort = String(record.id || '').slice(-4);
+  const entry = record.entryPrice;
+  const dir = record.direction;
+
+  let deltaStr = 'N/A';
+  if (exitPrice != null && entry != null && isFinite(exitPrice) && isFinite(entry)) {
+    const delta = dir === 'BUY' ? exitPrice - entry : entry - exitPrice;
+    // Crypto moves in whole units, forex in 5th-decimal pips — pick a sane
+    // precision instead of printing 0.0000 for a real BTC move.
+    const digits = Math.abs(entry) >= 100 ? 2 : 5;
+    deltaStr = (delta >= 0 ? '+' : '') + delta.toFixed(digits);
+  }
+
+  return [
+    '🎯 Result: ' + winLoss + ' ' + emoji,
+    '',
+    '📌 Signal No. ' + idShort,
+    '📊 ' + record.pair + ' · ' + dir,
+    'Entry: ' + (entry != null ? entry : '?') + ' → Exit: ' + (exitPrice != null ? exitPrice : '?'),
+    'Δ: ' + deltaStr,
+  ].join('\n');
+}
+
+/**
+ * Plain-text sendMessage. No parse_mode on purpose — see the header note and
+ * the Bot's own Bug#1 comment.
+ */
+export async function sendTelegramMessage(chatId, text, env) {
+  const url = TELEGRAM_API + '/bot' + env.BOT_TOKEN + '/sendMessage';
+  const res = await fetch(url, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({
+      chat_id: chatId,
+      text: String(text || ''),
+      disable_web_page_preview: true,
+    }),
+  });
+  if (!res.ok) {
+    const body = await res.text().catch(() => '');
+    console.warn('Telegram sendMessage failed: chatId=' + chatId
+      + ' status=' + res.status + ' body=' + body.slice(0, 200));
+    throw new Error('Telegram ' + res.status);
+  }
+  return res.json().catch(() => ({}));
+}
+
+/** /health support (spec §2.5). */
+export async function getPushStats(env) {
+  const enabled = !!(env && env.BOT_TOKEN);
+  const stats = {
+    pushEnabled: enabled,
+    botKvBound: !!(env && env.BOT_KV),
+    pushesLast24h: null,
+    subscriberCount: null,
+  };
+  if (!env || !env.SIGNAL_CACHE) return stats;
+
+  try {
+    const list = await env.SIGNAL_CACHE.list({ prefix: PUSH_LOG_PREFIX });
+    stats.pushesLast24h = ((list && list.keys) || []).length;
+  } catch (e) { /* leave null */ }
+
+  if (env.BOT_KV) {
+    try {
+      const autoUsers = await env.BOT_KV.get('auto_users', 'json');
+      stats.subscriberCount = Array.isArray(autoUsers) ? autoUsers.length : 0;
+    } catch (e) { /* leave null */ }
+  }
+  return stats;
+}
+
+export const __pushTest = {
+  normPair, confPct, claimPushLock,
+  PUSH_LOG_PREFIX, PUSH_LOCK_PREFIX, PUSH_LOCK_TTL_S, PUSH_LOG_TTL_S,
+};
